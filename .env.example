# Environment: "development" | "production". Controls cookie Secure flag and
# whether OAuth mock auto-login is reachable (never allowed in production).
APP_ENV=development

# REQUIRED. No default is provided anymore for security reasons -- the app
# will refuse to start without these. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# AI Mentor / Interview features (NVIDIA NIM — Llama 3.1 70B).
# Without this, chat/interview endpoints fall back to static responses instead of hanging.
NVIDIA_NIM_API_KEY=

# Optional: OpenAI-compatible gateway used for practice question generation/evaluation.
# Leave blank to use the built-in offline fallback generator.

# AI request tuning — keep these low for interactive UX; retries only fire on
# network/5xx/429 errors, never on bad auth or malformed responses.
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=12

# RapidAPI JSearch key for Job Search module
JSEARCH_API_KEY=
