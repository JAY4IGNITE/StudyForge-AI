# Environment: development | production
APP_ENV=development

# Required JWT secrets (32+ characters)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google OAuth 2.0 Web Application credentials
# Redirect URI: ${BACKEND_URL}/api/v1/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App credentials
# Authorization callback URL: ${BACKEND_URL}/api/v1/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=studyforge

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PRESIGNED_URL_EXPIRY_SECONDS=3600

# AI / integrations
NVIDIA_NIM_API_KEY=
JSEARCH_API_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@studyforge.ai
BREVO_SENDER_NAME=StudyForge AI

# AI request tuning
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=12
AI_MAX_DAILY_REQUESTS_PER_USER=100
